# ---- paths (relative to repo root unless absolute) ----
SCINET_DATA_DIR=./data
SCINET_LIBRARY_DIR=./data/library
SCINET_MARKDOWN_DIR=./data/markdown
SCINET_VECTORS_DIR=./data/vectors
SCINET_MODELS_DIR=./data/models
SCINET_DB_PATH=./data/scinet.db

# ---- api ----
SCINET_HOST=127.0.0.1
SCINET_PORT=8000
SCINET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- local ai ----
# SciNet provisions and serves its own models from SCINET_MODELS_DIR. It runs a
# private Ollama on its own port and never reads the system-wide model store,
# so the project is self-contained and portable.
SCINET_OLLAMA_PORT=11500
SCINET_OLLAMA_KEEP_ALIVE=60s
# Set this only to deliberately reuse an existing server (e.g. the system one
# on http://127.0.0.1:11434). Empty means "use the project's private instance".
SCINET_OLLAMA_URL_OVERRIDE=

# Vulkan device for tier 1's llama.cpp server. This machine enumerates the
# Intel iGPU as Vulkan0 and the RTX 4060 as Vulkan1; llama.cpp defaults to 0,
# so leaving this empty would run tier 1 on the integrated GPU.
SCINET_LLAMACPP_DEVICE=Vulkan1
# Tier 1 fails fast rather than stalling on a degenerate page (one fixture took
# 546 s for a single page). On timeout the router falls through to tier 2.
SCINET_TIER1_TIMEOUT_SECONDS=90
SCINET_TIER1_MAX_LAYOUT_TOKENS=3072

SCINET_LLM_MODEL=qwen3:8b
SCINET_VLM_MODEL=granite3.2-vision:2b
SCINET_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
SCINET_EMBED_DIM=1024
SCINET_LLM_NUM_CTX=8192
SCINET_DEVICE=cuda

# ---- privacy ----
# Master switch for ALL outbound network calls (Crossref / OpenAlex / arXiv).
# Off by default. Every call made while on is written to the egress_log table.
SCINET_ENRICHMENT_ENABLED=false
SCINET_ENRICHMENT_EMAIL=

# ---- pipeline ----
SCINET_PIPELINE_VERSION=1
SCINET_TIER0_WORKERS=4
SCINET_UMAP_MIN_PAPERS=200
