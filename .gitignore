# working notes — audits, brainstorms, execution plans. Kept beside the code
# for whoever is developing it, not shipped with it.
.archive/

# data — never committed. `**` because a second library lives one level
# down (SCINET_DATA_DIR=data/demo) and carries the same folders.
data/**/library/
data/**/markdown/
data/**/vectors/
data/**/logs/
data/models/
# Files cleanup took out of the library. Operator data, not source, and a
# quarantine run can be tens of megabytes of PDFs.
data/**/quarantine/
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node
node_modules/
dist/
.vite/

# env
.env
.env.local

# os
.DS_Store

# agent working files — personal, except the skills the project ships
.claude/*
!.claude/skills/

# generated test fixtures — rebuilt by tests/fixtures/generate.py
backend/tests/fixtures/generated/
backend/tests/fixtures/real/

# build caches
*.tsbuildinfo

# launch media (rendered locally, not shipped)
launch/
studio-output/
